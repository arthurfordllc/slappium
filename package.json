{
  "name": "slappium",
  "version": "1.0.0",
  "description": "Lightning-fast iOS testing CLI for AI agents",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/slap.js --banner:js='#!/usr/bin/env node'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
