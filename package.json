{
  "name": "@arthurfordllc/slappium",
  "version": "2.0.0",
  "description": "Lightning-fast iOS & Android testing CLI for AI agents. Interact with mobile apps via Appium with simple tap/type/assert commands.",
  "type": "module",
  "bin": {
    "slappium": "dist/slap.js",
    "slap": "dist/slap.js"
  },
  "files": [
    "dist",
    "bin",
    "slappium.config.example.json",
    "slappium.config.android.example.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/slap.js --banner:js='#!/usr/bin/env node'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "testing",
    "cli",
    "ios-testing",
    "android-testing",
    "appium",
    "ios-simulator",
    "android-emulator",
    "llm",
    "claude",
    "automation",
    "mobile-testing",
    "react-native",
    "xcuitest",
    "uiautomator2",
    "adb",
    "ai-testing",
    "developer-tools",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurfordllc/slappium.git"
  },
  "homepage": "https://github.com/arthurfordllc/slappium",
  "bugs": {
    "url": "https://github.com/arthurfordllc/slappium/issues"
  },
  "license": "MIT",
  "author": "Arthur Ford, LLC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
